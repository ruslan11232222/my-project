{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    /* Цільова платформа */
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    /* Модулі */
    "module": "NodeNext",
    "verbatimModuleSyntax": true,
    /* Виведення */
    "noEmit": true,
    /* Строгість */
    "strict": true,
    /* Сумісність і швидкодія */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["vite.config.ts"]
}